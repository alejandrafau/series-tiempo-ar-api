{
  "collections": [
    {
      "id": "ipc_productos",
      "nombre": "Precios al consumidor de productos específicos",
      "descripcion": "Precios al consumidor relevados por el INDEC para un conjunto de productos específicos de la canasta del IPC (pan francés, asado, leche, banana, etc.) y sus principales aperturas / grupos de productos. Incluye la serie mensual de fuente INDEC y la serie trimestral calculada por la SSPM, con desagregación por región cuando está disponible.",
      "limitations": [
        {
          "code": "gen_lim",
          "message": "Colección basada en el IPC con base diciembre 2016=100 publicado por INDEC. Cubre el conjunto de productos específicos y aperturas de la canasta relevados en la publicación 'Índice de Precios al Consumidor'. Para períodos previos a 2017 usar 'ipc_2013_2014' (base octubre 2013) o 'ipc_2008' (base abril 2008). Para el índice general (rubros COICOP) usar la colección 'ipc'."
        },
        {
          "code": "gen_lim",
          "message": "La serie mensual la publica INDEC directamente; la serie trimestral es un cálculo derivado que realiza la SSPM sobre las mismas fuentes."
        }
      ],
      "concepts": [
        {
          "id": "indec:ipc-productos-variacion-mensual",
          "nombre": "IPC Productos Variación mensual",
          "descripcion": "Serie mensual de precios al consumidor para productos específicos de la canasta del IPC, publicada por el INDEC. Se puede filtrar por producto específico o por grupo/apertura de productos, y por región.",
          "frecuencia": "monthly",
          "unidad": "pct_change",
          "sample_questions": [
            "¿Cuánto aumentó el precio de la nalga en el último año?",
            "¿Qué producto de la canasta fue el que más subió en 2024?",
            "¿En qué región aumentó más el pan?",
            "¿Qué familia de productos tuvo la mayor variación mensual?"
          ],
          "limitations": [
            {
              "code": "gaps_indec",
              "affects_dimension": "region",
              "message": "Solo AMBA tiene cobertura completa. Para las regiones pampeana, NOA, NEA, cuyo y patagonia, INDEC releva únicamente un subconjunto reducido de productos (pan francés, harina de trigo, arroz, fideos, carne picada, pollo, aceite de girasol, leche fresca en sachet, huevos, papa, azúcar, detergente líquido, lavandina y jabón de tocador)."
            },
